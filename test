#!/bin/bash

# حدد مسار مجلد المشروع بتاعك اللي فيه docker-compose
PROJECT_DIR="/path/to/your/project" 

# حدد مسار الهارد الخارجي اللي هتحفظ فيه
EXTERNAL_HDD="/mnt/my_external_hdd"

# توليد اسم ملف بيحتوي على تاريخ اليوم عشان الملفات ماتدخلش في بعض
DATE=$(date +"%Y-%m-%d_%H-%M-%S")
BACKUP_NAME="backup_$DATE.sql"

# الذهاب لمجلد المشروع وعمل الباك اب
cd $PROJECT_DIR
docker compose exec -T db pg_dump -U rsu_user -d rsu_db -c > $BACKUP_NAME

# نقل الملف للهارد الخارجي
mv $BACKUP_NAME $EXTERNAL_HDD/

echo "Backup done successfully at $DATE"


chmod +x auto_backup.sh


crontab -e

0 2 * * * /path/to/your/auto_backup.sh

